# Copy this file to .env and edit. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/internsetu
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Email for password-reset codes (optional). Leave empty in development: codes are printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Login session: the app renews the 60-minute token while the person is active, but never beyond this many days.
SESSION_MAX_DAYS=14
# Log detail: DEBUG, INFO, WARNING or ERROR. Logs hold request id, method, path, status and time only (no query strings, bodies, emails or passwords).
LOG_LEVEL=INFO
